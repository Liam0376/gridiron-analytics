# Copy to .env and fill in your own values — never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# Each user runs their own league(s) — add more anytime via the hub's
# league switcher (topbar). Use your own Sleeper league ID(s).

# Your Sleeper league ID (default league; optional — the hub setup screen
# accepts it on first run instead).
# Find it in the Sleeper app URL for your league.
SLEEPER_LEAGUE_ID=

# Optional — FantasyPros API key for draft/projection extras.
FANTASYPROS_API_KEY=

# Optional — override default SQLite path (default: data/fantasy.db).
# FFANALYTICS_DB_PATH=
