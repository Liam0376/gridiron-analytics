# Copy to .env and fill in your own values — never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# Each user runs their own single league (OSS v1 is single-league only;
# multi-league is an explicit non-goal — see README).
# Use your Sleeper league ID, not anyone else's.

# Your Sleeper league ID (required — app raises at import without it).
# Find it in the Sleeper app URL for your league.
SLEEPER_LEAGUE_ID=

# Optional — FantasyPros API key for draft/projection extras.
FANTASYPROS_API_KEY=

# Optional — override default SQLite path (default: data/fantasy.db).
# FFANALYTICS_DB_PATH=
